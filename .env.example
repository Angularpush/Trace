# ==============================================================================
# TRACE - Environment Configuration Template
# ==============================================================================

# Application Configuration
PROJECT_NAME=TRACE
PROJECT_DESCRIPTION=Document-Level MSME Transaction Reconciliation & Discrepancy Detection System
VERSION=1.0.0
API_V1_STR=/api/v1

# Server & Networking
PORT=8000
CORS_ORIGINS=*

# Database Configuration
# Default (Local Development): SQLite database located in backend/trace.db
DATABASE_URL=sqlite:///./trace.db
# Production (PostgreSQL on Render / Railway / AWS / Docker):
# DATABASE_URL=postgresql://trace_user:trace_password@localhost:5432/trace_db

# File & Storage Paths (Mounted volume in production)
STORAGE_DIR=./storage
UPLOAD_DIR=./storage
MAX_UPLOAD_SIZE_MB=50

# Frontend Environment Variable (Set on Vercel / Netlify / Frontend Hosting)
# Leave empty for unified proxy deployment (Docker / local dev)
# VITE_API_URL=https://your-backend-api-domain.com

# AI & LLM Provider Configuration
# Options: "offline" (recommended, zero external API keys required), "openai", "anthropic"
DEFAULT_LLM_PROVIDER=offline
LLM_PROVIDER=offline

# Optional Online LLM API Keys (Only needed if switching from "offline" to "openai" or "anthropic")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Embeddings & Semantic Search
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_TRANSFORMER_DOWNLOAD=0

# Deterministic Financial Tolerance Thresholds
PRICE_TOLERANCE_PERCENT=0.01
QUANTITY_TOLERANCE_PERCENT=0.00
MONETARY_TOLERANCE_AMOUNT=1.00

# Semantic Matching Thresholds
SUPPLIER_MATCH_THRESHOLD=0.72
ITEM_MATCH_THRESHOLD=0.68
DOCUMENT_LINK_THRESHOLD=0.65
